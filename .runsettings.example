<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the gdUnit4 engine tests. Copy it to .runsettings (git-ignored) and set GODOT_BIN
  to your Godot 4.7 .NET editor binary:
    cp .runsettings.example .runsettings
  Then run: dotnet test Godoodads.csproj --settings .runsettings
-->
<RunSettings>
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
    <TestSessionTimeout>600000</TestSessionTimeout>
    <EnvironmentVariables>
      <GODOT_BIN>/path/to/Godot_v4.7-stable_mono_linux.x86_64</GODOT_BIN>
    </EnvironmentVariables>
  </RunConfiguration>
  <GdUnit4>
    <Parameters>--headless</Parameters>
    <DisplayName>FullyQualifiedName</DisplayName>
  </GdUnit4>
</RunSettings>
